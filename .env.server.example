# Copy this file to .env.server on the server. Do not commit .env.server.

# Public URL used by Kan and Better Auth.
NEXT_PUBLIC_BASE_URL=https://kan.example.com
BETTER_AUTH_SECRET=replace-with-a-random-32-character-or-longer-secret

# The hostname is the existing PostgreSQL container name on kan-network.
# URL-encode special characters in the password.
POSTGRES_URL=postgresql://kan:replace-with-password@postgres:5432/kan_db

# Optional email configuration
NEXT_PUBLIC_DISABLE_EMAIL=true

# Required to upload avatars and comment/card attachments.
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=

# Optional services
REDIS_URL=
LOG_LEVEL=info
